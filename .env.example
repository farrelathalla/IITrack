# Basis data PostgreSQL untuk aplikasi dan seed.
DATABASE_URL="postgresql://iitrack:iitrack@localhost:5432/iitrack"

# Opsional. Basis data terpisah untuk `bun run test:integration`, supaya test
# tidak menambah project dan riwayat ke data pengembangan. Terapkan migrasinya
# dengan: DATABASE_URL=<url ini> bun run db:deploy
TEST_DATABASE_URL="postgresql://iitrack:iitrack@localhost:5432/iitrack_test"

# Kunci penandatangan cookie sesi. Nilai acak minimal 32 karakter.
# Bangkitkan dengan: openssl rand -base64 32
SESSION_SECRET=""
