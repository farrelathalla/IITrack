# Basis data PostgreSQL. Untuk development lokal, `bunx prisma dev` menjalankan
# instance Postgres lokal dan mencetak URL yang bisa disalin ke sini.
DATABASE_URL="postgresql://user:password@localhost:5432/iitrack"

# Kunci penandatangan cookie sesi. Nilai acak minimal 32 karakter.
# Bangkitkan dengan: openssl rand -base64 32
SESSION_SECRET=""
