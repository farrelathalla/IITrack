// Skema basis data IITrack, mengikuti IIT-PRD-IITRACK-DEV-2026 bab 12.
//
// Prinsip yang dipegang skema ini (PRD bab 1.1):
// - Satu project, satu record. Tab PM, Technology Dev, dan Finance membaca
//   baris yang sama, tidak ada salinan per divisi.
// - Dokumen hanya tautan. IITrack menyimpan alamat dan statusnya.
// - Finance hanya status. Invoice dan kwitansi tidak dibuat di sini.
// - Status stage dan status project dihitung dari data (src/lib/project),
//   bukan disimpan, supaya tidak ada dua sumber kebenaran.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Akun, jabatan, periode ────────────────────────────────────────────────

/// Jabatan pengurus (PRD bab 2.1). Divisinya diturunkan dari jabatan di
/// src/lib/auth/roles.ts, jadi tidak disimpan terpisah.
enum RoleName {
  SUPER_ADMIN
  COO
  VICE_COO
  PROJECT_MANAGER
  CTO
  VICE_CTO
  TECH_DEVELOPER
  CFO
  VICE_CFO
  FINANCE_POC
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

/// Akun tidak pernah dihapus, hanya dinonaktifkan, agar nama pelaku di riwayat
/// project tetap terbaca (PRD bab 2.5).
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String?
  status       UserStatus @default(ACTIVE)

  revokedAt    DateTime?
  revokedById  String?
  revokedBy    User?     @relation("UserRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)
  revokeReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revokedUsers       User[]              @relation("UserRevokedBy")
  roleAssignments    RoleAssignment[]    @relation("RoleHolder")
  rolesGranted       RoleAssignment[]    @relation("RoleGrantedBy")
  sessions           Session[]
  activities         ActivityLog[]
  notifications      Notification[]
  projectsCreated    Project[]
  assignments        ProjectAssignment[] @relation("AssignmentMember")
  assignmentsMade    ProjectAssignment[] @relation("AssignmentAssigner")
  documentsOwned     Document[]          @relation("DocumentOwner")
  documentsUpdated   Document[]          @relation("DocumentUpdatedBy")
  submissionsMade    Submission[]        @relation("SubmissionSubmitter")
  submissionsDecided Submission[]        @relation("SubmissionDecider")
  blockers           TechBlocker[]
  projectsDeleted    Project[]           @relation("ProjectDeletedBy")
  invitations        Invitation[]        @relation("InvitationFor")
  invitationsCreated Invitation[]        @relation("InvitationCreatedBy")

  @@map("users")
}

/// Periode kepengurusan, misalnya 2026/2027 dengan kode 2627 untuk Project ID.
model Period {
  id        String   @id @default(cuid())
  /// Label tampilan, misalnya "2026/2027".
  name      String   @unique
  /// Empat digit untuk Project ID, misalnya "2627".
  code      String   @unique
  startDate DateTime
  /// Eksklusif. Pada tanggal ini akses pengurus periode tersebut berakhir.
  endDate   DateTime
  createdAt DateTime @default(now())

  roleAssignments RoleAssignment[]

  @@map("periods")
}

/// Jabatan seseorang pada satu periode. Mengubah jabatan menutup baris lama
/// (`endedAt`) dan membuat baris baru, sehingga riwayatnya tetap utuh.
model RoleAssignment {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation("RoleHolder", fields: [userId], references: [id], onDelete: Restrict)
  role     RoleName
  periodId String
  period   Period   @relation(fields: [periodId], references: [id], onDelete: Restrict)

  /// Terisi bila jabatan ini diakhiri sebelum periodenya habis.
  endedAt DateTime?

  grantedById String?
  grantedBy   User?    @relation("RoleGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("role_assignments")
}

/// Sesi disimpan di basis data supaya bisa dicabut seketika (PRD bab 13).
model Session {
  id        String    @id @default(cuid())
  /// HMAC dari token sesi. Token aslinya hanya ada di cookie peramban.
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("sessions")
}

/// Link undangan sekali pakai. Anggota baru membuka link ini untuk membuat
/// kata sandinya sendiri; IITrack tidak mengirim email, Super Admin yang
/// menyalin dan mengirim linknya. Yang disimpan hanya HMAC tokennya.
model Invitation {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("InvitationFor", fields: [userId], references: [id], onDelete: Restrict)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  /// Terisi saat link diganti dengan link baru sebelum sempat dipakai.
  revokedAt   DateTime?
  createdById String
  createdBy   User      @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("invitations")
}

// ─── Project ───────────────────────────────────────────────────────────────

enum ProjectType {
  DEVELOPMENT
  ADVISORY
  HIRING
  DEPLOYMENT
  INTEGRATION
  OTHER
}

enum ProjectSource {
  BUSINESS_DEVELOPMENT
  NON_BD
  INTERNAL
  GOVERNMENT
  OTHER
}

enum FinalStatus {
  EARLY
  ON_TIME
  LATE
}

model Project {
  id         String @id @default(cuid())
  /// Nomor resmi, misalnya IIT-2627-014. Unik dan tidak pernah didaur ulang.
  code       String @unique
  periodCode String
  sequence   Int

  name         String
  client       String
  type         ProjectType?
  source       ProjectSource?
  targetStart  DateTime
  targetEnd    DateTime
  internalNote String?

  /// Terisi saat PM atau COO menandai project selesai. Project yang sudah
  /// ditutup bersifat read-only untuk semua jabatan.
  closedAt    DateTime?
  finalStatus FinalStatus?

  // Penanda stage yang butuh tombol eksplisit dari PM (PRD bab 4.1).
  stage1DoneAt       DateTime?
  developmentDoneAt  DateTime?

  /// Soft delete oleh COO/VCOO. Project yang dihapus hilang dari semua daftar
  /// dan tidak bisa dibuka, tetapi barisnya (dan riwayatnya) tetap ada dan
  /// Project ID-nya tidak pernah dipakai ulang.
  deletedAt    DateTime?
  deletedById  String?
  deletedBy    User?     @relation("ProjectDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  deleteReason String?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments  ProjectAssignment[]
  stages       ProjectStage[]
  documents    Document[]
  submissions  Submission[]
  staffing     StaffingRequest?
  techInfo     TechInfo?
  blockers     TechBlocker[]
  milestones   Milestone[]
  terms        Term[]
  handover     Handover?
  disbursement Disbursement?
  activities   ActivityLog[]

  @@unique([periodCode, sequence])
  @@map("projects")
}

/// Penghitung nomor project per periode. Dinaikkan di transaksi yang sama
/// dengan pembuatan project, sehingga nomor tidak kembar dan tidak berlubang.
model ProjectNumberCounter {
  periodCode    String   @id
  highestIssued Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@map("project_number_counters")
}

enum ProjectRole {
  PM
  DEVELOPER
  FINANCE_POC
}

/// Penugasan orang ke project (PRD bab 2.2). Saat diganti, baris lama ditutup
/// dengan `endedAt` dan baris baru dibuat; riwayat tidak pernah dihapus.
model ProjectAssignment {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  userId    String
  user      User        @relation("AssignmentMember", fields: [userId], references: [id], onDelete: Restrict)
  role      ProjectRole
  /// Role teknis, khusus developer, misalnya "Full-stack Developer".
  techRole  String?

  assignedById String
  assignedBy   User      @relation("AssignmentAssigner", fields: [assignedById], references: [id], onDelete: Restrict)
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  @@index([projectId, role])
  @@index([userId])
  @@map("project_assignments")
}

/// Tenggat dan waktu selesai per stage. Status lain (terkunci, berjalan,
/// menunggu persetujuan, revisi) dihitung dari data. Waktu selesai disimpan
/// sekali saat syaratnya pertama kali terpenuhi dan tidak pernah dicabut, supaya
/// penggantian developer atau dokumen di kemudian hari tidak mengunci ulang
/// stage sesudahnya di tengah pengerjaan.
model ProjectStage {
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  stage       Int
  deadline    DateTime?
  completedAt DateTime?

  @@id([projectId, stage])
  @@map("project_stages")
}

// ─── Dokumen dan pengajuan ─────────────────────────────────────────────────

enum DocumentKind {
  REQUIREMENT_GATHERING
  PROJECT_CHARTER
  GANTT_CHART
  MOU
  PROGRAMMER_CONTRACT
  PROGRESS_REPORT
  TESTING_RESULT
  BAST
  CLIENT_FEEDBACK
  PROGRAMMER_FEEDBACK
  PROJECT_DOCUMENTATION
  SOURCE_CODE_DOCUMENTATION
}

/// Status isi dokumen (PRD bab 4.4). Status persetujuan ada di Submission,
/// status tanda tangan di `signedAt`.
enum DocumentStatus {
  MISSING
  IN_PROGRESS
  SUBMITTED
  DONE
}

/// Tautan dokumen beserta statusnya. Satu baris per jenis per project, kecuali
/// Kontrak Programmer yang satu per developer (`developerId`).
model Document {
  id          String         @id @default(cuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  kind        DocumentKind
  /// Kosong untuk semua jenis kecuali Kontrak Programmer. Diisi string kosong
  /// alih-alih NULL supaya unique constraint berlaku.
  developerId String         @default("")
  url         String?
  status      DocumentStatus @default(MISSING)
  deadline    DateTime?
  signedAt    DateTime?

  ownerId     String?
  owner       User?    @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  updatedById String?
  updatedBy   User?    @relation("DocumentUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions Submission[]

  @@unique([projectId, kind, developerId])
  @@map("documents")
}

enum SubmissionKind {
  PROJECT_CHARTER
  MOU
  PROGRAMMER_CONTRACT
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Pengajuan dokumen ke approver (PRD bab 6). Setiap pengajuan ulang membuat
/// baris baru, sehingga riwayat penolakan dan feedback tetap terbaca.
/// Keputusan pertama yang masuk yang berlaku: pembaruan hanya dilakukan pada
/// baris yang masih PENDING.
model Submission {
  id         String           @id @default(cuid())
  projectId  String
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  kind       SubmissionKind
  documentId String
  document   Document         @relation(fields: [documentId], references: [id], onDelete: Restrict)
  status     SubmissionStatus @default(PENDING)

  submittedById String
  submittedBy   User      @relation("SubmissionSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt   DateTime  @default(now())
  decidedById   String?
  decidedBy     User?     @relation("SubmissionDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt     DateTime?
  feedback      String?

  @@index([projectId, kind])
  @@index([status])
  @@map("submissions")
}

// ─── Tech Development ─────────────────────────────────────────────────────

enum StaffingStatus {
  WAITING_TECHDEV
  DEVELOPER_ASSIGNED
}

/// Request SDM dari PM ke CTO/VCTO (PRD bab 4.7). Satu per project; belum ada
/// baris berarti "Request Belum Diajukan".
model StaffingRequest {
  projectId     String         @id
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  technicalNeeds String
  roleRequested String
  headcount     Int
  neededBy      DateTime
  status        StaffingStatus @default(WAITING_TECHDEV)
  submittedById String
  submittedAt   DateTime       @default(now())
  assignedById  String?
  assignedAt    DateTime?

  @@map("staffing_requests")
}

model TechInfo {
  projectId       String    @id
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  githubRepo      String?
  sprintPlanning  String?
  currentSprint   String?
  progressPercent Int?
  nextMilestone   String?
  /// Diisi PM (bagian Operasional di Stage 6).
  latestUpdate    String?
  latestUpdateAt  DateTime?
  updatedAt       DateTime  @updatedAt

  @@map("tech_infos")
}

model TechBlocker {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  description String
  resolvedAt  DateTime?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())

  @@index([projectId])
  @@map("tech_blockers")
}

/// Client-Facing Milestones yang diisi PM.
model Milestone {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  name      String
  date      DateTime
  doneAt    DateTime?
  sortOrder Int       @default(0)

  @@index([projectId])
  @@map("milestones")
}

// ─── Finance ───────────────────────────────────────────────────────────────

/// Langkah alur status per termin (PRD bab 5.2).
enum TermStep {
  NOT_STARTED
  INVOICE_REQUESTED
  PROCESSING
  INVOICE_APPROVED
  SENT_TO_CLIENT
  PROOF_SUBMITTED
  PAYMENT_RECEIVED
  RECEIPT_ISSUED
  DONE
}

/// Termin pembayaran. Urutan 1 selalu DP; urutan terakhir adalah termin final.
model Term {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  sequence   Int
  name       String
  percentage Decimal  @db.Decimal(5, 2)
  amount     Decimal  @db.Decimal(18, 2)
  /// Tanggal jatuh tempo, atau kosong bila memakai teks seperti "Setelah BAST".
  dueDate    DateTime?
  dueNote    String?

  step     TermStep @default(NOT_STARTED)
  /// Alasan penolakan terakhir oleh Finance POC, dikosongkan saat diajukan lagi.
  feedback String?

  invoiceRequestUrl  String?
  approvedInvoiceUrl String?
  transferProofUrl   String?
  receiptUrl         String?
  completedAt        DateTime?
  updatedAt          DateTime  @updatedAt

  @@unique([projectId, sequence])
  @@map("terms")
}

enum UatStatus {
  NOT_STARTED
  SCHEDULED
  PASSED
  NEEDS_FIX
}

model Handover {
  projectId     String    @id
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  uatStatus     UatStatus @default(NOT_STARTED)
  warrantyStart DateTime?
  warrantyEnd   DateTime?
  updatedAt     DateTime  @updatedAt

  @@map("handovers")
}

enum DisbursementStatus {
  SUBMITTED
  VERIFIED
  APPROVED
  DISBURSED
  REJECTED
}

/// Finance Disbursement (PRD bab 5.5). Belum ada baris berarti belum diajukan.
model Disbursement {
  projectId     String             @id
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  status        DisbursementStatus
  feedback      String?
  submittedById String
  submittedAt   DateTime
  verifiedById  String?
  verifiedAt    DateTime?
  decidedById   String?
  decidedAt     DateTime?
  disbursedById String?
  disbursedAt   DateTime?

  @@map("disbursements")
}

// ─── Riwayat, notifikasi, pengaturan ──────────────────────────────────────

enum ActivityResult {
  CREATED
  UPDATED
  SUBMITTED
  APPROVED
  REJECTED
}

/// Riwayat aktivitas. Hanya bisa ditambah; UPDATE dan DELETE ditolak trigger
/// basis data (PRD bab 13). Dipakai untuk aktivitas project maupun akun.
model ActivityLog {
  id         String          @id @default(cuid())
  projectId  String?
  project    Project?        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  actorId    String?
  actor      User?           @relation(fields: [actorId], references: [id], onDelete: Restrict)
  /// Kode mesin, misalnya "mou.submitted". Katalognya di src/lib/activity.
  action     String
  /// Kalimat yang ditampilkan, misalnya "Mengajukan MoU untuk persetujuan".
  summary    String
  /// Stage (1-9) atau divisi yang terkait, untuk tampilan riwayat.
  stage      Int?
  division   String?
  result     ActivityResult  @default(UPDATED)
  feedback   String?
  objectType String?
  objectId   String?
  data       Json?
  createdAt  DateTime        @default(now())

  @@index([projectId, createdAt])
  @@index([createdAt])
  @@map("activity_logs")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  message   String
  /// Tautan tujuan, misalnya /projects/IIT-2627-014?stage=3&tab=pm.
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

/// Pengaturan sistem dalam bentuk kunci-nilai (PRD bab 8.7 dan 12).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}
