// Skema basis data IITrack.
//
// Model ditambahkan per fitur mengikuti pembagian sprint, bukan sekaligus di
// muka. Berkas ini berisi fondasi yang dipakai seluruh fitur sejak Sprint 0.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Division {
  OPERATIONAL
  FINANCE
  TECHDEV
}

enum UserStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

/// Anggota pengurus yang memakai IITrack. Anggota TechDev yang hanya
/// mengerjakan kode tidak punya akun di sini (PRD bab 2.1).
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  /// Kosong selama akun masih berstatus INVITED dan belum diaktivasi.
  passwordHash String?
  status       UserStatus @default(INVITED)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roleAssignments RoleAssignment[]
  sessions        Session[]
  auditLogs       AuditLog[]

  @@map("users")
}

enum RoleName {
  COO
  VICE_COO
  CFO
  VICE_CFO
  CTO
  VICE_CTO
  PROJECT_MANAGER
  FINANCE_POC
  OFFICER_OPERATIONAL
  TECHDEV_MEMBER
}

/// Penetapan jabatan beserta masa berlakunya. Izin menempel pada penetapan ini,
/// bukan pada orangnya, sehingga akses berhenti sendiri ketika kepengurusan
/// berganti (F03).
model RoleAssignment {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          RoleName
  division      Division
  /// Label periode kepengurusan, misalnya "2026/2027".
  period        String
  /// Awal masa jabatan, inklusif.
  startDate     DateTime
  /// Akhir masa jabatan, eksklusif. Kosong berarti belum ditentukan.
  endDate       DateTime?
  /// System Administrator privilege, bukan divisi keempat (PRD bab 3.5).
  isSystemAdmin Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([startDate, endDate])
  @@map("role_assignments")
}

/// Sesi masuk disimpan di basis data, bukan hanya di dalam cookie, supaya bisa
/// dicabut seketika ketika masa jabatan habis atau akun dinonaktifkan (F02).
model Session {
  id        String    @id @default(cuid())
  /// HMAC dari token sesi. Token aslinya hanya ada di cookie peramban.
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?

  @@index([userId])
  @@map("sessions")
}

/// Jejak aktivitas. Entri hanya bisa ditambah: pemblokiran UPDATE dan DELETE
/// ditegakkan trigger basis data, bukan hanya disiplin kode, sehingga jabatan
/// mana pun termasuk pemegang System Administrator privilege tidak dapat
/// merapikan catatan lama (PRD bab 5, Ketertelusuran).
model AuditLog {
  id         String   @id @default(cuid())
  /// Kosong bila pelakunya belum teridentifikasi, misalnya percobaan masuk
  /// dengan email yang tidak terdaftar.
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  objectType String
  objectId   String?
  /// Nilai sebelum dan sesudah perubahan, kosong untuk aksi yang tidak mengubah data.
  before     Json?
  after      Json?
  /// Alasan yang wajib diisi pada aksi tertentu, misalnya penolakan dan override.
  reason     String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([objectType, objectId])
  @@index([createdAt])
  @@map("audit_logs")
}
